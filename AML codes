import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.tree import DecisionTreeClassifier
from sklearn.model_selection import GridSearchCV, validation_curve

data = pd.read_csv("iris.csv")
features = data[["sepal.length", "sepal.width", "petal.length", "petal.width"]]
target = data["variety"]

print("Dataset Shape:", data.shape)
print("Features:\n", features.head())
print("Target:\n", target.head())

parameters = {
    "max_depth": [None, 2, 3, 4, 5, 6, 7, 8],
    "min_samples_split": [2, 4, 6, 8, 10]
}

model = DecisionTreeClassifier(random_state=42)
grid = GridSearchCV(model, parameters, cv=5, scoring="accuracy", n_jobs=-1)
grid.fit(features, target)

print("\nBest Parameters:", grid.best_params_)
print("Best Cross-Validation Accuracy:", grid.best_score_)

depth_range = np.arange(1, 15)

train_scores, validation_scores = validation_curve(
    DecisionTreeClassifier(
        min_samples_split=grid.best_params_["min_samples_split"],
        random_state=42
    ),
    features, target,
    param_name="max_depth",
    param_range=depth_range,
    cv=5, scoring="accuracy"
)

plt.plot(depth_range, train_scores.mean(axis=1), marker="o", label="Training Score")
plt.plot(depth_range, validation_scores.mean(axis=1), marker="o", label="Cross-Validation Score")
plt.title("Validation Curve for Decision Tree")
plt.xlabel("Maximum Depth (max_depth)")
plt.ylabel("Accuracy")
plt.xticks(depth_range)
plt.grid(True)
plt.legend()
plt.show()
