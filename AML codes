import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.svm import SVC
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, confusion_matrix
import time

data = pd.read_csv("iris.csv")
data = data[data["variety"].isin(["Setosa", "Virginica"])]

features = data[["sepal.length", "sepal.width"]].values
target = LabelEncoder().fit_transform(data["variety"])

x_train, x_test, y_train, y_test = train_test_split(
    features, target, train_size=0.7, random_state=42, stratify=target
)

scaler = StandardScaler()
x_train_scaled = scaler.fit_transform(x_train)
x_test_scaled = scaler.transform(x_test)
models = {}

for kernel in ["linear", "poly", "rbf"]:
    model = SVC(kernel=kernel, degree=3, gamma="scale", random_state=42)

    start_time = time.time()
    model.fit(x_train_scaled, y_train)
    training_time = time.time() - start_time

    predictions = model.predict(x_test_scaled)
    accuracy = accuracy_score(y_test, predictions)
    matrix = confusion_matrix(y_test, predictions)

    models[kernel] = model

    print("\nKernel:", kernel)
    print("Training time: {:.4f} seconds".format(training_time))
    print("Accuracy:", round(accuracy * 100, 2), "%")
    print("Confusion Matrix:\n", matrix)
    
def plot_boundary(features, target, model, title):
    x_min, x_max = features[:, 0].min() - 1, features[:, 0].max() + 1
    y_min, y_max = features[:, 1].min() - 1, features[:, 1].max() + 1

    grid_x, grid_y = np.meshgrid(
        np.arange(x_min, x_max, 0.02),
        np.arange(y_min, y_max, 0.02)
    )

    predictions = model.predict(np.c_[grid_x.ravel(), grid_y.ravel()])
    predictions = predictions.reshape(grid_x.shape)

    plt.contourf(grid_x, grid_y, predictions, alpha=0.3, cmap="Set1")
    scatter = plt.scatter(
        features[:, 0], features[:, 1],
        c=target, edgecolors="k", cmap="Set1"
    )

    plt.title(title)
    plt.xlabel("Sepal Length (scaled)")
    plt.ylabel("Sepal Width (scaled)")
    plt.legend(*scatter.legend_elements(), title="Classes")
    plt.show()

for kernel, model in models.items():
    plot_boundary(x_train_scaled, y_train, model, kernel + " Kernel")
