state_map = {state: i for i, state in enumerate(states)}

sequence = ["walk", "shop", "clean", "clean", "walk", "walk", "shop"]
encoded_sequence = np.array([obs_map[obs] for obs in sequence]).reshape(-1, 1)

actual_states = ["Sunny", "Rainy", "Rainy", "Rainy", "Sunny", "Sunny", "Rainy"]
encoded_states = np.array([state_map[state] for state in actual_states])

model = hmm.CategoricalHMM(n_components=2, init_params="")
model.startprob_ = [0.6, 0.4]
model.transmat_ = [[0.7, 0.3], [0.4, 0.6]]
model.emissionprob_ = [[0.1, 0.4, 0.5], [0.6, 0.3, 0.1]]

log_probability, predicted_states = model.decode(encoded_sequence, algorithm="viterbi")
predicted_names = [states[state] for state in predicted_states]

print("Predicted States:", predicted_names)
print("Actual States:", actual_states)
print("Accuracy:", round(accuracy_score(encoded_states, predicted_states), 2))
print("Log Probability:", round(log_probability, 2))

def plot_matrix(matrix, rows, columns, title):
    sns.heatmap(matrix, annot=True, fmt=".2f", cmap="Blues",
                xticklabels=columns, yticklabels=rows)
    plt.title(title)
    plt.xlabel("To")
    plt.ylabel("From")
    plt.show()

