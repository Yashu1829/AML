import numpy as np
import matplotlib.pyplot as plt
def gaussian_kernel(x, x0, tau):
    return np.exp(-np.sum((x - x0) ** 2, axis=1) / (2 * tau ** 2))
def locally_weighted_regression(X, y, x0, tau):
    m = len(X)
    W = np.eye(m)
    weights = gaussian_kernel(X, x0, tau)
    np.fill_diagonal(W, weights)
    XTWX = X.T @ W @ X
    theta = np.linalg.pinv(XTWX) @ X.T @ W @ y
    return x0 @ theta
np.random.seed(42)
x = np.linspace(-3, 3, 50)
y = np.sin(x) + 0.3 * np.random.randn(50)
X = np.c_[np.ones(len(x)), x]
xtest = np.linspace(-3, 3, 100)
Xtest = np.c_[np.ones(len(xtest)), xtest]
tau = 0.5
ypred = np.array([
    locally_weighted_regression(X, y, x0, tau)
    for x0 in Xtest
])
plt.figure(figsize=(10, 6))
plt.scatter(x, y, color="red", label="Training Data")
plt.plot(xtest, ypred, color="blue", label="LWR")
plt.title("Locally Weighted Regression")
plt.xlabel("X")
plt.ylabel("Y")
plt.legend()
plt.show()
