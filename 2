import numpy as np
import matplotlib.pyplot as plt
np.random.seed(42)
mu_real = 5
sigma_real = 2
N = 100
data = np.random.normal(mu_real, sigma_real, N)
iters = 2000
mu_samples = []
sigma_samples = []
mu = 0
sigma = 1
for i in range(iters):
    mu = np.random.normal(np.mean(data), sigma / np.sqrt(N))
    alpha = N / 2
    beta = np.sum((data - mu) ** 2) / 2
    sigma = np.sqrt(1 / np.random.gamma(alpha, 1 / beta))
    mu_samples.append(mu)
    sigma_samples.append(sigma)
plt.figure(figsize=(8, 4))
plt.subplot(2, 1, 1)
plt.plot(mu_samples)
plt.axhline(mu_real, color="red")
plt.title("Mu Trace")
plt.subplot(2, 1, 2)
plt.plot(sigma_samples)
plt.axhline(sigma_real, color="red")
plt.title("Sigma Trace")
plt.tight_layout()
plt.show()
print("Estimated Mu:", np.mean(mu_samples))
print("Estimated Sigma:", np.mean(sigma_samples))
